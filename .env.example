# ==========================================================================
# BRIO WORLD SCHOOL - ENVIRONMENT CONFIGURATION SCHEMA (.env.example)
# ==========================================================================
# IMPORTANT: Keep real credentials in hosting environment / config.php.
# DO NOT commit real passwords or secret keys to public repositories.

# Website Domain & Deployment Settings
SITE_URL=https://syonra.life
FTP_HOST=syonra.life
FTP_USER=deploy@syonra.life
FTP_PASS=YOUR_FTP_PASSWORD_HERE

# Database Configuration (SQLite File-Based DB)
DB_DRIVER=sqlite
DB_FILE=schooltask.sqlite

# SMTP Email Dispatcher (PHPMailer / Mail Helper)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_SECURE=tls
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=YOUR_SMTP_APP_PASSWORD_HERE

# Admin Portal Authentication
ADMIN_USER=admin
ADMIN_PASS=YOUR_ADMIN_PASSWORD_HASH_HERE
