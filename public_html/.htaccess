DirectoryIndex index.html

<IfModule mod_headers.c>
    # Prevent browser caching of HTML, JS, CSS for live updates
    <FilesMatch "\.(html|htm|js|css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct web access to private app and storage folders
    RewriteRule ^app/ - [F,L]
    RewriteRule ^storage/ - [F,L]

    # Never rewrite requests to actual PHP files
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_FILENAME} \.php$
    RewriteRule ^ - [L]

    # Route all /api/ requests to index.php PHP router
    RewriteRule ^api/(.*)$ index.php/$1 [QSA,L]

    # For everything else that's not a real file/dir, serve index.html (SPA)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
