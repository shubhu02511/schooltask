DirectoryIndex index.php

<IfModule mod_headers.c>
    # Prevent browser caching of HTML, JS, CSS for live updates
    <FilesMatch "\.(html|htm|js|css)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct web access to private app and storage folders
    RewriteRule ^app/ - [F,L]
    RewriteRule ^storage/ - [F,L]

    # Serve real static files directly (like CSS & JS in assets/)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Route all other web requests to index.php front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
